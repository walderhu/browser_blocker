{
  "manifest_version": 3,
  "name": "Режим концентрации",
  "version": "1.0.0",
  "description": "Помогает сосредоточиться и блокирует отвлекающие сайты.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Режим концентрации",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
